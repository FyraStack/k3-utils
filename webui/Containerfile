# syntax=docker/dockerfile:1

FROM docker.io/nginx:1.29-alpine

RUN apk add --no-cache gettext

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY index.html /usr/share/nginx/html/index.html
COPY config.js.template /etc/nginx/templates/config.js.template
COPY entrypoint.sh /usr/local/bin/webui-entrypoint
RUN chmod +x /usr/local/bin/webui-entrypoint

ENV RELAY_1_NAME="Relay 1" \
    RELAY_2_NAME="Relay 2" \
    RELAY_3_NAME="Relay 3" \
    RELAY_4_NAME="Relay 4"

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["wget", "--no-verbose", "--tries=1", "--spider", "http://127.0.0.1:8080/healthz"]

ENTRYPOINT ["/usr/local/bin/webui-entrypoint"]
