# syntax=docker/dockerfile:1

FROM debian:bookworm-slim AS build

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
        ca-certificates \
        g++ \
        libgpiod-dev \
        libgpiodcxx-dev \
        meson \
        mold \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

RUN meson setup build --prefix=/usr \
    && meson compile -C build \
    && meson install -C build --destdir /rootfs

FROM debian:bookworm-slim AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
        libgpiod2 \
        libgpiodcxx2 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /rootfs/usr/bin/relay-gpio /usr/bin/relay-gpio
COPY --from=build /rootfs/usr/share/relay-gpio /usr/share/relay-gpio

WORKDIR /usr/share/relay-gpio

ENV GPIO_CHIP=/dev/gpiochip0 \
    RELAY_ACTIVE_LOW=1 \
    RELAY_HTTP_PORT=8080

EXPOSE 8080

ENTRYPOINT ["/usr/bin/relay-gpio"]
